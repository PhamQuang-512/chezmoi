// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "gutter": {
    "min_line_number_digits": 4,
    "git_gutter_width": {
      "custom": 16.0
    }
  },
  "show_whitespaces": "selection",
  "buffer_font_family": "MesloLGS Nerd Font Mono",
  "buffer_font_size": 12,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400,
  "buffer_font_features": { "calt": false },
  "ui_font_size": 15,
  "indent_guides": { "enabled": true, "coloring": "indent_aware" },
  "cli_default_open_behavior": "existing_window",
  "format_on_save": "off",
  "file_scan_exclusions": ["**/.git", "**/.DS_Store", "**/.terraform", "**/.terragrunt-cache", "**/node_modules", "**/charts/*.tgz"],
  "file_types": {
    "Helm": ["**/templates/**/*.tpl", "**/templates/**/*.yaml"],
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/host_vars/*.yml",
      "**/host_vars/*.yaml",
      "**/playbooks/*.yaml",
      "**/playbooks/*.yml",
      "**playbook*.yaml",
      "**playbook*.yml"
    ],
    "Git Attributes": ["**/{git,.git,.git/info}/attributes"],
    "Git Config": ["*.gitconfig", "**/{git,.git,.git/modules,.git/modules/*}/config"],
    "Git Ignore": ["**/{git,.git}/ignore", "**/.git/info/exclude"],
    "Dockerfile": ["Dockerfile.*", "Containerfile.*"],
  },
  "unstable.ui_density": "compact",
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "thinking_display": "always_collapsed",
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "default_width": 300.0,
    "threads_sidebar": {
      "default_width": 300.0,
      "position": "right"
    },
    "terminal_init_command": "",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "terminal": {
    "font_size": 12.0,
    "font_family": "MesloLGL Nerd Font Mono",
    "show_count_badge": true,
    "starts_open": true,
    "toolbar": { "breadcrumbs": false },
    "line_height": "standard",
    "font_features": { "calt": false },
    "copy_on_select": true,
    "option_as_meta": true,
    "env": { "EDITOR": "zed --wait" }
  },
  "agent_ui_font_size": 12,
  "agent_buffer_font_size": 12,
  "ui_font_weight": 500,
  "session": {
    "trust_all_worktrees": false
  },
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "mode": "accept-edits",
        "thinking_level": "high",
        "model": "gemini-4-argon"
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry",
      "default_config_options": {
        "mode": "auto_edit"
      },
      "env": {
        "GOOGLE_CLOUD_PROJECT": "om-gemini-enterprise-np",
        "GOOGLE_CLOUD_LOCATION": "global"
      }
    },
    "codex-acp": {
      "default_config_options": {
        "model": "glm-5.3"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus",
        "effort": "xhigh",
        "mode": "auto",
        "fast": false
      },
      "type": "registry"
    }
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "theme_overrides": {
    "Catppuccin Mocha": {
      "text": "#e6e9f5",
      "text.muted": "#bac2de",
      "text.placeholder": "#9399b2",

      "panel.background": "#181825",
      "editor.background": "#1e1e2e",
      "element.background": "#313244",
      "border": "#585b70",
      "border.variant": "#45475a",
      "border.focused": "#ffaaff",

      "terminal.background": "#11111b",
      "terminal.foreground": "#e6e9f5",
      "terminal.dim_foreground": "#bac2de",
      "terminal.ansi.bright_black": "#9399b2"
    }
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_root": true,
    "folder_indicator": "icon",
    "entry_spacing": "standard",
    "indent_size": 12.0,
    "git_status_indicator": true,
    "bold_folder_labels": true,
    "dock": "left"
  },
  "languages": {
    "Terraform": { "format_on_save": "on" },
    "YAML": { "format_on_save": "on" },
    "Shell Script": {
      "format_on_save": "on",
      "formatter": { "external": { "command": "shfmt", "arguments": ["-i", "2", "-ci"] } }
    },
  },

}
